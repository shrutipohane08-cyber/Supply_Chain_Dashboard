      <table>
        <view>
          <datasources>
            <datasource caption='Fact_Orders+ (supply_chain_cleandataset)' name='federated.126etw91dogkyb0zrq07615un7oo' />
          </datasources>
          <datasource-dependencies datasource='federated.126etw91dogkyb0zrq07615un7oo'>
