              <bucket>&quot;USA&quot;</bucket>
              <bucket>&quot;Germany&quot;</bucket>
              <bucket>&quot;Bangladesh&quot;</bucket>
              <bucket>&quot;China&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.126etw91dogkyb0zrq07615un7oo].[none:Supplier_City:nk]</column>
            <column>[federated.126etw91dogkyb0zrq07615un7oo].[mn:Order_Date:ok]</column>
