            <column-instance column='[Supplier_City]' derivation='None' name='[none:Supplier_City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Supplier_Country]' derivation='None' name='[none:Supplier_Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Reliability_Score]' derivation='Avg' name='[pcto:avg:Reliability_Score:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Pane' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <manual-sort column='[federated.126etw91dogkyb0zrq07615un7oo].[none:Supplier_Country:nk]' direction='ASC'>
